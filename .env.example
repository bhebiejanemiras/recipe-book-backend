# Copy this file to .env and replace the placeholder values below.
# Never commit .env - it is already excluded by .gitignore.

APP_NAME=AppsDev API Tutorial
PORT=7000
NODE_ENV=development

# Generate strong, different secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret
CSRF_SECRET=replace_with_a_different_random_secret

BACKEND_URL=https://recipe-book-backend-dkxq.onrender.com

# The frontend origin(s) allowed by CORS. In production this is your deployed
# frontend URL. Multiple origins may be separated with commas, e.g.
#   FRONTEND_URL=https://my-app.vercel.app,https://my-app-git-main-team.vercel.app
FRONTEND_URL=https://recipe-book-taupe-rho.vercel.app/

# Hosted PostgreSQL connection string. Neon connection strings include ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/recipe_book
